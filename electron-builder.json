{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.tally.app",
  "productName": "Tally",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64", "arm64"] },
      { "target": "deb", "arch": ["x64", "arm64"] },
      { "target": "rpm", "arch": ["x64"] },
      { "target": "tar.gz", "arch": ["x64"] }
    ],
    "category": "Utility",
    "icon": "build/icon.svg",
    "maintainer": "Tally Developer",
    "synopsis": "Minimalist Pomodoro, Habits, and Counters desktop app",
    "description": "Gruvbox-themed Pomodoro timer, habit tracker, and tally counters desktop app.",
    "desktop": {
      "StartupWMClass": "tally"
    }
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "build/icon.svg"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Tally",
    "uninstallDisplayName": "Tally"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64", "universal"] },
      { "target": "zip", "arch": ["x64", "arm64", "universal"] }
    ],
    "category": "public.app-category.productivity",
    "icon": "build/icon.svg",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
